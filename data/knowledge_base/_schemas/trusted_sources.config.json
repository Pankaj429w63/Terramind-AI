  "placeholder_detection": {
    "url_patterns": [
      "example\\.com",
      "example\\.org",
      "example\\.net",
      "REPLACE",
      "PLACEHOLDER",
      "placeholder",
      "TODO",
      "FIXME",
      "^https?://$",
      "^$"
    ],
    "source_patterns": [
      "SOURCE REQUIRED",
      "source required",
      "REPLACE-WITH",
      "PLACEHOLDER",
      "placeholder",
      "\\[SOURCE REQUIRED",
      "^$"
    ],
    "title_patterns": [
      "^\\[PLACEHOLDER\\]",
      "^PLACEHOLDER",
      "TODO",
      "REPLACE-WITH"
    ],
    "content_patterns": [
      "\\[REQUIRED:",
      "\\[SOURCE REQUIRED",
      "REPLACE-WITH-AUTHORITATIVE-SOURCE",
      "Do not fabricate",
      "leave this note in place",
      "until real content is inserted",
      "placeholder until sourced",
      "until sourced"
    ],
    "author_patterns": [
      "Institution/Author to be provided",
      "REPLACE",
      "PLACEHOLDER",
      "^$"
    ],
    "date_patterns": [
      "^0000-00-00$",
      "^$",
      "YYYY"
    ],
    "blocked_domains": [
      "example.com",
      "example.org",
      "example.net",
      "localhost",
      "127.0.0.1"
    ]
  },
  "reliability_upgrade_rules": {
    "description": "Rules to auto-upgrade/validate reliability when URL/source matches a higher tier during validation.",
    "mode": "warn_if_conflict"
  },
  "minimum_required_rules": [
    {
      "categories": ["diseases", "treatment"],
