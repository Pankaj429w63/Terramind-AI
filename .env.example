# BACKEND ONLY. Copy to root .env.local for local development.
# SUPABASE_SERVICE_ROLE_KEY is secret and must never use a NEXT_PUBLIC_ name.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key

# Load the verified checkpoint from the repository or private Supabase Storage.
TERRAMIND_MODEL_PATH=models/archive/2026-09-09_efficientnet_b0_official_v3/best_model.pth
TERRAMIND_MODEL_BUCKET=model-artifacts
TERRAMIND_MODEL_OBJECT=efficientnet-b0/best_model.pth
TERRAMIND_MODEL_SHA256=replace-with-the-checkpoint-sha256

# Render enables auto-ingest for the bundled 218-document knowledge base.
TERRAMIND_RAG_AUTO_INGEST=false
# Optional Qdrant Cloud/self-hosted service; local persistent Qdrant is the default.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=

# Optional experimental multimodal checkpoint; leave unset to report unavailable.
TERRAMIND_MULTIMODAL_CHECKPOINT=

TERRAMIND_LOW_CONFIDENCE_THRESHOLD=0.35
TERRAMIND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
